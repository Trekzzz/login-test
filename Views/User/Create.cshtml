@model LoginModule.Models.UserModel

<h1>Create User</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Full Name</label>
        <input asp-for="Fullname" />
    </div>

    <br />

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <br />

    <button type="submit">
        Create
    </button>

</form>