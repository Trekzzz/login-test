@model List<LoginModule.Models.UserModel>

<h1>User Accounts</h1>

<a href="/User/Create">
    Create User
</a>

<br />
<br />

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Actions</th>
    </tr>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Id</td>
            <td>@user.Fullname</td>
            <td>@user.Email</td>

            <td>
                <a href="/User/Edit/@user.Id">
                    Edit
                </a>

                |

                <a href="/User/Delete/@user.Id">
                    Delete
                </a>
            </td>
        </tr>
    }

</table>