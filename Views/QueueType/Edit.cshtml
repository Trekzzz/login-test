@model LoginModule.Models.QueueTypeModel

<h1>Edit Queue Service</h1>

<form asp-action="Edit" method="post">

    <input asp-for="Id" hidden />

    <div>
        <label>Service Name</label>
        <input asp-for="Name" />
    </div>

    <br />

    <div>
        <label>Description</label>
        <input asp-for="Description" />
    </div>

    <br />

    <div>
        <label>Active</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>

    <br />

    <button type="submit">
        Update Service
    </button>

</form>